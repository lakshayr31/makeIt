# Copy to .env and fill in keys from the hackathon brief.

# Image generation (GPT Image Flare)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Copilot: DeepSeek-V4-Pro (Azure, OpenAI-compatible)
DEEPSEEK_PRO_BASE_URL=https://crux-hackathon-swe.openai.azure.com/openai/v1/
