DEEPSEEK_PRO_API_KEY=

# Copilot: DeepSeek-V4.1-Flash (Azure, OpenAI-compatible; accepts images)
DEEPSEEK_FLASH_BASE_URL=https://crux-hackathon-eus2.openai.azure.com/openai/v1/
